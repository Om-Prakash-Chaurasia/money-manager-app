# Money Manager Backend Environment Configuration Template

# Server Configuration
NODE_ENV=production
PORT=5001

# Database Connection
MONGODB_URI=mongodb://localhost:27017/money_manager_db

# Cryptographic Authentication & JWT Secrets
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_here_min_32_characters
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_here_min_32_characters
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_URL=http://localhost:3000

# File Storage & Attachments
STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=5

# Rate Limiting Guardrails
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
